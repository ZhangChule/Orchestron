*.dexel
*.voxel
*.npy
*.npz
*.h5
*.hdf5
*.vtk
*.vtu
*.ply.cache

# 加工仿真输出
simulation_outputs/
results/
exports/
generated_models/
generated_meshes/

# =========================
# Large media / model files
# =========================
# 如果这些是源资产，可以不要 ignore，而是用 Git LFS 管理
# 如果只是生成产物，可以打开下面这些 ignore
# *.stp
# *.step
# *.iges
# *.igs
# *.fbx
# *.glb
# *.gltf
# *.obj
# *.stl
# *.ply
# *.mp4
# *.mov
# *.avi

