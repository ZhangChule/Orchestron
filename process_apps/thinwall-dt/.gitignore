# =========================
# Frontend: React + Vite
# =========================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/.vite/
frontend/.cache/
frontend/coverage/
frontend/*.local

# Vite local env files
frontend/.env
frontend/.env.*
!frontend/.env.example

# TypeScript
frontend/*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Package manager cache
.pnpm-store/
.yarn/
.yarn-cache/

# =========================
# Three.js / R3F generated assets
# =========================
# 如果这些是运行时生成或转换出来的文件，建议忽略
frontend/public/generated/
frontend/public/cache/
frontend/public/tmp/

# Unity WebGL preview assets are required by the standalone app.
frontend/public/unity-build/
frontend/public/unity/
frontend/public/Build/

# =========================
# Backend: FastAPI + Pydantic
# =========================
backend/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd

backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.coverage
backend/htmlcov/

backend/venv/
backend/.venv/
backend/env/
backend/.env
backend/.env.*
!backend/.env.example

# Python packaging
backend/build/
backend/dist/
backend/*.egg-info/

# Local database / cache
backend/*.sqlite3
backend/*.db
backend/.cache/
backend/tmp/
backend/temp/

# Uploads and generated files
backend/uploads/
backend/generated/
backend/static/generated/
backend/media/
backend/results/
backend/simulation_outputs/

# =========================
# Unity project
# =========================
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Bb]uild/
unity/[Bb]uilds/
